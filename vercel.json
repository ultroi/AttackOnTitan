{
  "version": 2,
  "builds": [
    {
      "src": "main.py",       # Now points to root-level file
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"       # Routes all traffic to root-level file
    }
  ]
}
