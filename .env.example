# Environment Variables Example for AoT Bot

# Telegram Bot Token (Required)
TELEGRAM_TOKEN=your_bot_token_here

# MongoDB Connection (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/attackontitan

# Dashboard URL for production (Optional)
# Leave empty for automatic ngrok tunnel setup
# For local development: http://localhost:5000/dashboard
# For production: https://yourdomain.com/dashboard
DASHBOARD_URL=

# Port for Flask app (Optional, default: 5000)
PORT=5000

# ngrok Configuration (Optional)
# If you have an ngrok auth token for better tunnels
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Example production deployment URLs:
# Heroku: https://your-app-name.herokuapp.com/dashboard
# Vercel: https://your-app-name.vercel.app/dashboard
# Railway: https://your-app-name.railway.app/dashboard
# ngrok (auto): will be generated automatically when bot starts
# Render: https://your-app-name.render.com/dashboard
